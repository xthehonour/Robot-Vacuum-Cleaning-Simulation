<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.robot.simulation.controller.MainController">
    <left>
        <VBox prefWidth="250.0" spacing="15.0" style="-fx-background-color: #f4f4f4;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label text="Kontrol Paneli">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Separator prefWidth="200.0" />

                <GridPane hgap="5.0" vgap="5.0">
                  <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                  </columnConstraints>
                  <rowConstraints>
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  </rowConstraints>
                   <children>
                      <Label text="Genişlik:" />
                      <Label text="Yükseklik:" GridPane.rowIndex="1" />
                      <Spinner fx:id="spinGenislik" editable="true" GridPane.columnIndex="1" />
                      <Spinner fx:id="spinYukseklik" editable="true" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                   </children>
                </GridPane>

                <Label text="Algoritma Seçimi:" />
                <ComboBox fx:id="comboAlgoritma" maxWidth="1.7976931348623157E308" />

                <Label text="Simülasyon Hızı:" />
                <Slider fx:id="sliderHiz" blockIncrement="1.0" max="10.0" min="1.0" showArrows="true" value="1.0" />

                <Separator prefWidth="200.0" />

                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnBaslat" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#baslat" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Başlat" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnDurdur" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#durdur" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Durdur" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
                <Button fx:id="btnSifirla" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#sifirla" text="Sıfırla" />

                <Separator prefWidth="200.0" />

                <Label text="Pil Durumu:" />
                <ProgressBar fx:id="progressPil" maxWidth="1.7976931348623157E308" progress="1.0" />
                <Label fx:id="lblPil" alignment="CENTER" maxWidth="1.7976931348623157E308" text="%100" />

                <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                    <Label text="Olay Günlüğü:">
                        <font>
                            <Font name="System Italic" size="13.0" />
                        </font>
                    </Label>
                    <ListView fx:id="listLog" VBox.vgrow="ALWAYS" />
                </VBox>
            </children>
        </VBox>
    </left>
    <center>
        <ScrollPane BorderPane.alignment="CENTER">
            <content>
                <StackPane style="-fx-background-color: #ddd;">
                    <Canvas fx:id="canvas" height="600.0" width="700.0" />
                </StackPane>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="20.0" style="-fx-background-color: #333; -fx-padding: 5;">
            <children>
                <Label text="Gösterge:" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <Label text="● Mavi: Robot" textFill="#2196f3" />
                <Label text="● Siyah: Engel" textFill="WHITE" />
                <Label text="● Sarı: Şarj" textFill="YELLOW" />
                <Label text="● Pembe: Toz" textFill="PINK" />
                <Label text="● Turkuaz: Sıvı" textFill="CYAN" />
                <Label text="● Kahve: Leke" textFill="BROWN" />
                <Label text="● Yeşil: Temiz" textFill="LIGHTGREEN" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
